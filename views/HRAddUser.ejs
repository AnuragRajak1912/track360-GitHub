<div class="container my-4">

    <div id="alert-placeholder"></div>

    <form id="AddUser">

      <h3>Assign Employee to a Project</h3>
      <div class="form-group my-4">
        <label for="emp_email">Employee email</label>
        <input 
            type="email" 
            class="form-control" 
            id="emp_email" 
            placeholder="Enter name of the Company"
            name="emp_email">
      </div>
      <div class="form-group my-4">
        <label for="exampleFormControlSelect1">Select Project</label>
        <select class="form-control" id="project" name="project">
          <% for( let index = 0; index < projectName.length; index++ ) { %>
            <option value="<%= projectID[index] %>">
                <%= projectName[index] %>
            </option>
          <% } %>
        </select>
      </div>
      
      
      <button type="submit" class="btn btn-primary">Submit</button>
    </form>
  </div>

